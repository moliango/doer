    "crypto.toolbox.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select likely ciphertext in a post to decrypt. In the editor, tap the key or + to encrypt and insert. Covers AES, 3DES, ChaCha20, Base64/Hex/ROT13, hashes, RSA, and classic ciphers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中帖子里的疑似密文会出现「解密」。编辑器里点钥匙或「+」菜单即可加密插回。算法覆盖 AES、3DES、ChaCha20、Base64/Hex/ROT13、哈希、RSA 与经典密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選中帖子裡的疑似密文會出現「解密」。編輯器裏點鑰匙或「+」菜單即可加密插回。算法覆蓋 AES、3DES、ChaCha20、Base64/Hex/ROT13、哈希、RSA 與經典密碼。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選中帖子裏的疑似密文會出現「解密」。編輯器裏點鑰匙或「+」菜單即可加密插回。算法覆蓋 AES、3DES、ChaCha20、Base64/Hex/ROT13、哈希、RSA 與經典密碼。"
          }
        }
      }
    },
